# Verification container for install.sh's dnf branch of check_deps().
#
# fedora:latest (confirmed empirically to be Fedora 44 as of this writing)
# already ships bash, curl and dnf out of the box in the plain container
# image -- nothing extra needs installing to exercise check_deps() as a
# real user's shell would run it. systemctl is NOT present in this
# container base (Fedora's container image strips the init system, unlike
# a real desktop install where systemd is always present) -- see
# check-deps-harness.sh's systemctl section, which just reports presence/
# absence rather than trying to fight that.
FROM fedora:latest

WORKDIR /work
# Build context is the repo root (see docker/run-distro-tests.sh) so this
# picks up the real install.sh under test, not a copy.
COPY install.sh /work/install.sh
COPY docker/check-deps-harness.sh /work/check-deps-harness.sh
RUN chmod +x /work/check-deps-harness.sh

ENTRYPOINT ["/work/check-deps-harness.sh", "/work/install.sh"]
